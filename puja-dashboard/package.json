{
  "name": "puja-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n db,web -c yellow,cyan \"npm:db\" \"next dev\"",
    "dev:web": "next dev",
    "db": "node scripts/db.mjs",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "mongoose": "^9.12.3",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "mongodb-memory-server": "^11.4.0",
    "tailwindcss": "4.3.3"
  }
}
